<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Deliberately NOT a ProjectReference to TreeCounterAddin - that project's assembly has a
    hard dependency edge on ArcGIS Pro's own DLLs (ArcGIS.Core, ArcGIS.Desktop.*), so anything
    referencing it would need ArcGIS Pro installed just to run these pure-math checks.
    Instead the two math files are compiled directly into this standalone console project via
    <Compile Include>, so `dotnet run` here works on any machine with just the .NET SDK.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TreeCounterAddin\SliverMath.cs" Link="SliverMath.cs" />
    <Compile Include="..\TreeCounterAddin\BiomassMath.cs" Link="BiomassMath.cs" />
    <Compile Include="..\TreeCounterAddin\FlightMissionMath.cs" Link="FlightMissionMath.cs" />
  </ItemGroup>

</Project>
