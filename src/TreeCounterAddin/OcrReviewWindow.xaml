<Window x:Class="TreeCounterAddin.OcrReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review OCR Coordinates" Height="450" Width="700"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Coordinates read from each photo's visible watermark via OCR - review and correct before creating points. Uncheck any row that looks wrong; nothing is written to the map until you click Create Points."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Create Points" Width="120" Padding="6" Margin="0,0,8,0" Click="CreatePoints_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Padding="6" IsCancel="True"/>
        </StackPanel>

        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Use" Binding="{Binding Include, Mode=TwoWay}" Width="40"/>
                <DataGridTextColumn Header="Photo" Binding="{Binding FileName}" Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="X (Easting/Lon)" Binding="{Binding X, Mode=TwoWay}" Width="100"/>
                <DataGridTextColumn Header="Y (Northing/Lat)" Binding="{Binding Y, Mode=TwoWay}" Width="100"/>
                <DataGridTextColumn Header="WKID" Binding="{Binding Wkid, Mode=TwoWay}" Width="70"/>
                <DataGridTextColumn Header="OCR raw text" Binding="{Binding RawText}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
