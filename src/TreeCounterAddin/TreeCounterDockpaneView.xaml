<UserControl x:Class="TreeCounterAddin.TreeCounterDockpaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TreeCounterAddin"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="300">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:BilingualTooltipConverter x:Key="BilingualTooltip"/>
        <local:InverseBooleanConverter x:Key="InverseBool"/>
        <local:UiTextConverter x:Key="UiText"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Width" Value="140"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <Style x:Key="HintLine" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Every feature section is an Expander with this style so each tab stays
             collapsible/compact - every section defaults collapsed so a tab with several
             features opens tidy instead of showing every form at once. BasedOn the implicit Expander
             style ArcGIS Pro registers app-wide - without it, a keyed style with no BasedOn
             falls back to WPF's raw stock chrome (a circular chevron) instead of Pro's own
             flat-arrow look, which is what made these look inconsistent with the Settings
             Expanders below (which had no explicit Style, so picked up Pro's implicit one). -->
        <Style x:Key="SectionExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="SectionContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <Style x:Key="TabContent" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="{Binding Heading}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Layers}" DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Refresh}" Command="{Binding RefreshLayersCommand}"
                        DockPanel.Dock="Right" Padding="6,0" FontSize="10"
                        ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=RefreshTooltip}"/>
            </DockPanel>

            <!-- Grouped by where each feature sits in the field workflow: get the area ready,
                 bring field data back in, run analysis on it, then the rarely-touched settings. -->
            <TabControl>
                <TabItem Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Tab_Prepare}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_SurveyAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedFlightPlanningLayer}" Margin="0,0,0,8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- ToolTip on both the label and the box (same bilingual lookup, see
                                         BilingualTooltipConverter.cs) - hover either to see it, and it
                                         switches language with whatever's picked on the Help tab
                                         (IsHelpEnglish is shared app-wide, not a second language toggle). -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_AltitudeLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Altitude}"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FlightAltitudeM}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Altitude}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_GsdLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Gsd}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FlightGsdCmPerPx}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Gsd}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_ImageWidthLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=ImageWidth}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FlightImageWidthPx}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=ImageWidth}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_ImageHeightLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=ImageHeight}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding FlightImageHeightPx}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=ImageHeight}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_FrontOverlapLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=FrontOverlap}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FlightFrontOverlapPct}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=FrontOverlap}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_SideOverlapLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=SideOverlap}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding FlightSideOverlapPct}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=SideOverlap}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_DirectionLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Direction}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding FlightDirectionDeg}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Direction}"/>
                                    <!-- Full-width row (not squeezed into the 90px value column above) so these
                                         buttons stay readable even in a narrow docked panel. -->
                                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal"
                                                HorizontalAlignment="Right" Margin="0,0,0,2">
                                        <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_Vertical}" Command="{Binding SetDirectionVerticalCommand}"
                                                Padding="6,2" ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_VerticalTooltip}"/>
                                        <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_Horizontal}" Command="{Binding SetDirectionHorizontalCommand}"
                                                Padding="6,2" Margin="4,0,0,0" ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_HorizontalTooltip}"/>
                                        <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_Suggest}" Command="{Binding SuggestDirectionCommand}"
                                                Padding="6,2" Margin="4,0,0,0"
                                                ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_SuggestTooltip}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_SpeedLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Speed}"/>
                                    <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding FlightSpeedMs}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Speed}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="0" Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_BatteryLabel}" VerticalAlignment="Center"
                                               ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Battery}"/>
                                    <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding MaxFlightMinutesPerBattery}" Margin="0,2"
                                             ToolTip="{Binding IsHelpEnglish, Converter={StaticResource BilingualTooltip}, ConverterParameter=Battery}"/>
                                    <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_CrossHatch}"
                                              IsChecked="{Binding CrossHatch}" Margin="0,4,0,2"/>
                                    <CheckBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_CorridorMode}"
                                              IsChecked="{Binding CorridorMode}" Margin="0,2,0,2"
                                              ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_CorridorModeTooltip}"/>
                                </Grid>

                                <StackPanel Visibility="{Binding CorridorMode, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_CenterlineLabel}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PolylineLayers}" SelectedItem="{Binding SelectedCorridorCenterlineLayer}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_GenerateMission}" Command="{Binding GenerateMissionCommand}" Style="{StaticResource ActionButton}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsGeneratingMission, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding FlightMissionStatus}" Style="{StaticResource StatusLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_ExportFormatLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                                <ComboBox ItemsSource="{Binding ExportFormats}" SelectedItem="{Binding SelectedExportFormat}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsKmzFormatSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_DroneModelLabel}" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding DroneModelNames}" SelectedItem="{Binding SelectedDroneModel}" Margin="0,0,0,8"/>
                                </StackPanel>

                                <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=FlightPlanner_ExportMission}" Command="{Binding ExportMissionCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Fishnet_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Fishnet_PlanningLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedPolygonLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Fishnet_CellSizeLabel}" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox Text="{Binding CellWidth}" Width="60"/>
                                    <TextBlock Text=" x " VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox Text="{Binding CellHeight}" Width="60"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Fishnet_Create}" Command="{Binding CreateFishnetCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelFishnetCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsCreatingFishnet, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsCreatingFishnet, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding FishnetStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Gpx_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Gpx_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Layer}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding GpxLayers}" SelectedItem="{Binding SelectedGpxLayer}" Margin="0,0,0,8"/>

                                <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Gpx_Export}" Command="{Binding ExportGpxCommand}" Style="{StaticResource ActionButton}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsExportingGpx, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding GpxStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Tab_FieldData}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_DownloadTemplate}" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource ActionButton}"/>
                                <TextBlock Text="{Binding TemplateStatus}" Style="{StaticResource StatusLine}" Margin="0,4,0,10"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_CoordSystemLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding UtmZoneOptions}" SelectedItem="{Binding SelectedUtmZoneLabel}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsOtherZoneSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_WkidLabel}" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CruisingWkid}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=ExcelImport_Import}" Command="{Binding ImportExcelCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelImportExcelCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsImportingExcel, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsImportingExcel, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding ImportExcelStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoImport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoImport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoImport_Import}" Command="{Binding ImportPhotosCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelImportPhotosCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsImportingPhotos, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsImportingPhotos, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding PhotoImportStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_FormatLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding OcrFormatOptions}" SelectedItem="{Binding OcrFormat}" Margin="0,0,0,8"/>

                                <StackPanel Visibility="{Binding IsUtmFormatSelected, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_DefaultZoneLabel}" Style="{StaticResource FieldLabel}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBox Text="{Binding OcrDefaultZone}" Width="50"/>
                                        <ComboBox ItemsSource="{Binding OcrHemisphereOptions}" SelectedItem="{Binding OcrDefaultHemisphere}" Width="120" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_SelectPhotos}" Command="{Binding ScanPhotosForCoordinatesCommand}" Style="{StaticResource ActionButton}"
                                        ToolTip="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=PhotoOcr_SelectPhotosTooltip}"/>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsScanningPhotos, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding PhotoOcrStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=CruisingReport_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=CruisingReport_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=CruisingReport_LayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PointLayers}" SelectedItem="{Binding SelectedReportLayer}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=CruisingReport_Generate}" Command="{Binding GenerateReportCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelReportCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsGeneratingReport, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <ProgressBar IsIndeterminate="True" Height="14" Margin="0,8,0,0"
                                             Visibility="{Binding IsGeneratingReport, Converter={StaticResource BoolToVis}}"/>

                                <TextBlock Text="{Binding ReportStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Tab_Analyze}">
                    <StackPanel Style="{StaticResource TabContent}">
                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=TreeDetection_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedRasterLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=TreeDetection_ProfileLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" Margin="0,0,0,8"/>

                                <CheckBox Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=TreeDetection_ExcludeCleared}"
                                          IsChecked="{Binding ExcludeClearedLand}" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=TreeDetection_Detect}" Command="{Binding RunDetectionCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding Progress}" Height="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
                        </Expander>

                        <Expander Header="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=LandClearing_Header}" Style="{StaticResource SectionExpander}">
                            <StackPanel Style="{StaticResource SectionContent}">
                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=LandClearing_Hint}"
                                           Style="{StaticResource HintLine}"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=RasterLayerLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RasterLayers}" SelectedItem="{Binding SelectedLandClearingRasterLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=LandClearing_ExcludeAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding PolygonLayers}" SelectedItem="{Binding SelectedExcludeAreaLayer}" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=LandClearing_MinAreaLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MinClearingAreaHa}" Width="80" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=LandClearing_Detect}" Command="{Binding DetectLandClearingCommand}" Style="{StaticResource ActionButton}"/>
                                    <Button Content="{Binding IsHelpEnglish, Converter={StaticResource UiText}, ConverterParameter=Cancel}" Command="{Binding CancelLandClearingCommand}" Style="{StaticResource ActionButton}" Margin="6,0,0,0"
                                            Visibility="{Binding IsDetectingLandClearing, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <Grid Margin="0,8,0,0" Visibility="{Binding IsDetectingLandClearing, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Value="{Binding LandClearingProgress}" Height="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding LandClearingProgress, StringFormat={}{0}%}"
                                               HorizontalAlignment="Right" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center"/>
                                </Grid>

                                <TextBlock Text="{Binding LandClearingStatus}" Style="{StaticResource StatusLine}"/>
                            </StackPanel>
