<UserControl x:Class="TreeCounterAddin.PopupCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="260">
    <Border Background="White" BorderBrush="#FFA0A0A0" BorderThickness="1" CornerRadius="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Image x:Name="PhotoImage" Height="160" Stretch="UniformToFill"/>
                <Button x:Name="CloseButton" Content="X" Width="20" Height="20" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                        Background="#CC000000" Foreground="White" BorderThickness="0"
                        Click="CloseButton_Click" ToolTip="Close"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="10,8,10,10">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="13" TextWrapping="Wrap"/>
                <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="Gray" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
